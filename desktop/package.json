{
  "name": "teams-listener",
  "version": "1.0.0",
  "private": true,
  "description": "Teams Listener desktop app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:engine": "..\\.venv\\Scripts\\pyinstaller ..\\packaging\\engine.spec -y --distpath build\\engine-dist --workpath ..\\build\\pyi",
    "dist": "npm run build:engine && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.teamslistener",
    "productName": "Teams Listener",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/engine-dist/teams-listener-engine",
        "to": "engine"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}
